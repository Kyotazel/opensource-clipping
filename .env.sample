# ==============================================================================
# OpenSource Clipping — Environment Variables
# ==============================================================================
# Copy this file to `.env` and fill in your API keys:
#   cp .env.sample .env
# ==============================================================================

# [REQUIRED] Google Gemini API Key
# Get yours at: https://aistudio.google.com/apikey
GOOGLE_API_KEY=your-gemini-api-key-here

# [OPTIONAL] Pexels API Key — needed for B-roll stock footage
# Get yours at: https://www.pexels.com/api/
PEXELS_API_KEY=your-pexels-api-key-here

# [OPTIONAL] HuggingFace Token — needed for split-screen mode (Pyannote speaker diarization)
# Get yours at: https://huggingface.co/settings/tokens
# You must also accept the model agreement: https://huggingface.co/pyannote/speaker-diarization-3.1
HF_TOKEN=your-hf-token-here


# [REQUIRED IF USING NVIDIA / OpenAI-compatible Provider]
# Default: get yours at https://build.nvidia.com/
# You can also point it at any OpenAI-compatible endpoint, e.g. OpenRouter:
#   NVIDIA_BASE_URL=https://openrouter.ai/api/v1
#   NVIDIA_API_KEY=sk-or-v1-...
NVIDIA_API_KEY=your-nvidia-api-key-here

# [OPTIONAL] Override the NVIDIA NIM endpoint (default https://integrate.api.nvidia.com/v1).
# Use an OpenAI-compatible endpoint like OpenRouter:
#   NVIDIA_BASE_URL=https://openrouter.ai/api/v1
# and run with --ai-provider nvidia --nvidia-model <model-id> (e.g. deepseek/deepseek-chat).
# NVIDIA_BASE_URL=

# [OPTIONAL] If using auto uploader for facebook
META_PAGE_ID=111111111111111
META_PAGE_ACCESS_TOKEN=your-meta-api-key-here
META_GRAPH_VERSION=v25.0
APP_TIMEZONE=Asia/Jakarta

# Whisper (transcription) — CPU server default: device=auto -> int8
# WHISPER_MODEL=small            # small ≈ 500 MB, jauh lebih cepat; large-v3 lambat di CPU
# WHISPER_DEVICE=auto
# WHISPER_COMPUTE_TYPE=int8
# WHISPER_CPU_THREADS=16